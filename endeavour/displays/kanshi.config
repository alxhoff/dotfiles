# Kanshi — auto-switch Hyprland outputs on dock hotplug
# Install: pacman -S kanshi
# Link: ln -sf ~/git/Github/dotfiles/endeavour/displays/kanshi.config ~/.config/kanshi/config
# Run: systemctl --user enable --now kanshi.service
#
# Calibrate output names/descriptions with ./discover-monitors.sh
# Description matching is more stable than port names (DP-6 vs DP-7).

# --- Laptop only ---
profile laptop {
    output eDP-1, enable, mode, preferred, position, 0,0
}

# --- Work dock (HDMI + DisplayPorts) — adjust names ---
profile work {
    output HDMI-A-1, enable, mode, 1920x1200, position, 1200,232
    output DP-1, enable, mode, 1920x1200, position, 3120,0, transform, 90
    output DP-2, enable, mode, 1920x1200, position, 0,0, transform, 90
    output eDP-1, disable
    exec ~/.config/hypr/scripts/dotfiles-display-hook.sh work
}

# --- Home dock — adjust names; disable HDMI if present unused ---
profile home {
    output HDMI-A-1, disable
    output DP-3, enable, mode, 2560x1440, position, 0,0
    output DP-1, enable, mode, 3840x2160, position, 2560,0
    output eDP-1, enable, mode, 1920x1080, position, 640,1440
    exec ~/.config/hypr/scripts/dotfiles-display-hook.sh home
}

# Fallback when dock is partially enumerated (optional)
profile dock_settling {
    output eDP-1, enable, mode, preferred, position, 0,0
}
