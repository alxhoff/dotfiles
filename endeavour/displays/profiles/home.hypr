# Home dock — edit in nwg-displays, then re-save:
#   ./capture-layout.sh home > profiles/home.hypr
#
# Connector names (DP-7, DP-10, …) are updated on apply using the # description lines.

# Dell Inc. DELL UP2516D
monitor=DP-7,2560x1440@60,1920x192,1,transform,1

# ViewSonic Corporation VX3276-QHD
monitor=DP-8,2560x1440@60,3360x0,1

# Acer Technologies B246WL
monitor=DP-9,1920x1200@60,5920x192,1,transform,1

# Lenovo Group Limited (laptop panel off at dock)
monitor=eDP-1,disable
