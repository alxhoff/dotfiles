# Work dock (from i3 work-displays.sh)
# Three 1920x1200 panels; two rotated (transform 1 = 90° in Hyprland)
#
# Old xrandr: DP-1-2 center, DP-1-3 right (rotate left), DP-1-1 left (rotate left)
# Hypr: transform,1 is 90° — adjust to 3 or 270 if swapped

monitor=DP-1-2,1920x1200@60,1200x232,1
monitor=DP-1-3,1920x1200@60,3120x0,1,transform,1
monitor=DP-1-1,1920x1200@60,0x0,1,transform,1
monitor=eDP-1,disable
