# Reference home dock layout (connector names resolved at apply time from descriptions).
# Dell + Acer: portrait (transform,1). ViewSonic: landscape. Laptop panel: off.
#
# Apply: ./apply-display-profile.sh home
# Re-capture after GUI edit: ./capture-layout.sh home > profiles/home-captured.hypr

# DELL UP2516D → DP-* left portrait
# monitor=DP-?,2560x1440@60,1920x192,1,transform,1

# VX3276-QHD → DP-* center landscape
# monitor=DP-?,2560x1440@60,3360x0,1

# B246WL → DP-* right portrait
# monitor=DP-?,1920x1200@60,5920x192,1,transform,1

# Lenovo eDP-1 → disable
# monitor=eDP-1,disable
