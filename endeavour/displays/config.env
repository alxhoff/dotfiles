# Display profile detection — edit after running discover-monitors.sh in Hyprland
#
# Signatures: substring matched against connected monitor NAMES (hyprctl monitors)
# Use the most stable identifier you can (often HDMI-A-* for work dock)

# Work dock: your old polybar script used HDMI-A-0 as the tell
WORK_HDMI_PATTERN='HDMI-A'

# Home dock: multiple DisplayPorts; optional explicit names from polybar era
# (Hyprland may show DP-6, DP-7, … — discover script lists actual names)
HOME_DP_PATTERNS='DP-'

# Minimum external monitors (besides eDP) to treat as a docked profile
HOME_MIN_EXTERNAL=2
WORK_MIN_EXTERNAL=2

# Laptop panel name substring (usually eDP)
LAPTOP_PATTERN='eDP'

# Seconds to wait after hotplug (docks often enumerate monitors in stages)
HOTPLUG_SETTLE_SEC=2
