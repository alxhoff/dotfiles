# Which monitors mean which profile (match hardware description substrings)

# Home dock — all three must be connected
HOME_DOCK_DESCRIPTIONS='DELL UP2516D|VX3276-QHD|B246WL'

# Work dock — fill in after: ./discover-monitors.sh at the office
WORK_DOCK_DESCRIPTIONS=''

LAPTOP_PATTERN='eDP'

# Landscape center monitor at home dock (ViewSonic). Secondary/portrait bars stay minimal.
WAYBAR_PRIMARY_PATTERN='VX3276-QHD'

# Wait after plug/unplug before applying (seconds)
HOTPLUG_SETTLE_SEC=5

# Ignore hotplug events briefly after an apply (avoids reload loops)
APPLY_COOLDOWN_SEC=8
