[Desktop Entry]
Name=Steam Link
Comment=Stream games from another computer with Steam (Hyprland-friendly launcher)
Exec=@HOME@/.config/ml4w/scripts/steamlink.sh %u
Icon=com.valvesoftware.SteamLink
Terminal=false
Type=Application
Categories=Game;Network;RemoteAccess;
MimeType=x-scheme-handler/steamlink;
Keywords=Games
