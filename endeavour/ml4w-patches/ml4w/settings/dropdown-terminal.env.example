# Guake-style dropdown terminal (~/.config/ml4w/dropdown-terminal.env)
# Toggle: Alt+F12

DROPDOWN_TERM=kitty
DROPDOWN_CLASS=dropdown-terminal
DROPDOWN_TITLE=Dropdown
DROPDOWN_WORKSPACE=dropdown

# Panel on the focused monitor (% of visible size; portrait rotation handled automatically)
# DROPDOWN_SIZE=100% 42%
# DROPDOWN_MOVE=0 4
# DROPDOWN_CMD='tmux attach -t dropdown || tmux new -s dropdown'
