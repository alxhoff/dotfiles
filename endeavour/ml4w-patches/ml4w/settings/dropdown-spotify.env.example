# Dropdown Spotify (+ optional Discord split). Toggle with Alt+F11.
# When Discord is running it is moved to special:spotify and stays there (not restored on hide).

# Launch command (default: spotify-adblock when installed, else spotify)
# DROPDOWN_CMD=spotify-adblock

# Hyprland window classes
# DROPDOWN_CLASS=spotify
# DISCORD_CLASS=discord

# Special workspace name (must match windowrule + togglespecialworkspace)
# DROPDOWN_WORKSPACE=spotify

# Spotify-only layout (ignored when Discord is present for split view):
# DROPDOWN_SIZE=100% 100%
# DROPDOWN_MOVE=0 0
# DROPDOWN_MARGIN=12
# DROPDOWN_GAP=16
