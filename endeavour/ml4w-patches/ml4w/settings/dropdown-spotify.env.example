# Dropdown Spotify (~/.config/ml4w/dropdown-spotify.env)
# Toggle with Alt+F11 (next to Alt+F12 dropdown terminal).

# Launch command (default: spotify-adblock when installed, else spotify)
# DROPDOWN_CMD=spotify-adblock

# Hyprland window class (official Spotify client)
# DROPDOWN_CLASS=spotify

# Special workspace name (must match windowrule + togglespecialworkspace)
# DROPDOWN_WORKSPACE=spotify

# Top-anchored on primary monitor; clears waybar automatically (+ optional extra gap):
# DROPDOWN_SIZE=100% 50%
# DROPDOWN_MOVE=0 4
