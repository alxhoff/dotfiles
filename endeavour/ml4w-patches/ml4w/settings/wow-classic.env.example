# Copy to ~/.config/ml4w/wow-classic.env after adding Battle.net to Steam.
# App ID: Steam → library → Battle.net shortcut → Properties (or shortcuts.vdf).

BNET_STEAM_APPID=
WOW_STEAM_APPID=

# Optional: force a GE-Proton build name from ~/.steam/root/compatibilitytools.d
# PROTON_GE=GE-Proton10-XX

USE_GAMEMODE=1
USE_GAMESCOPE=0
GAMESCOPE_ARGS=-W 2560 -H 1440 -f
