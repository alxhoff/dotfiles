# Wine prefix from the Battle.net *installer* Steam shortcut (not the Battle.net.exe shortcut).
BNET_COMPAT_APPID=3588130076

# Installed client (default: Battle.net Launcher.exe — required for CEF UI on Hyprland):
# BNET_EXE=$HOME/.local/share/Steam/steamapps/compatdata/3588130076/pfx/drive_c/Program Files (x86)/Battle.net/Battle.net Launcher.exe

# Optional direct WoW Classic launch after install:
# WOW_EXE=$HOME/.local/share/Steam/steamapps/compatdata/3588130076/pfx/drive_c/Program Files (x86)/World of Warcraft/_classic_/WowClassic.exe

PROTON_DIR=/usr/share/steam/compatibilitytools.d/proton-ge-custom
USE_STEAM_RUNTIME=1
PROTON_DISABLE_ESYNC=1
PROTON_DISABLE_FSYNC=1
PROTON_USE_XALIA=0
PROTON_USE_WINED3D=1
PROTON_LOG=0
WINE_SIMULATE_WRITECOPY=1
WINEDLLOVERRIDES=locationapi=d
BNET_DISABLE_GPU=1

# Steam Play: point shortcut at Battle.net Launcher.exe, then launch options:
# STEAM_COMPAT_DATA_PATH="$HOME/.local/share/Steam/steamapps/compatdata/3588130076" PROTON_USE_XALIA=0 PROTON_DISABLE_ESYNC=1 PROTON_DISABLE_FSYNC=1 WINE_SIMULATE_WRITECOPY=1 PROTON_USE_WINED3D=1 %command%
# Also run once: wow-classic.sh configure

USE_GAMEMODE=1
USE_GAMESCOPE=0
GAMESCOPE_ARGS="-W 2560 -H 1440 -f"
