{
    "layer": "top",
    "name": "primary",
    "margin-top": 4,
    "margin-bottom": 0,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 0,

    "include": [
        "~/.config/ml4w/settings/waybar-quicklinks.json",
        "~/.config/waybar/modules.json"
    ],
    "modules-left": [
        "custom/appmenu",
        "hyprland/workspaces",
        "custom/passthrough",
        "group/quicklinks",
        "custom/exit",
        "idle_inhibitor"
    ],
    "modules-center": [
        "group/center"
    ],
    "group/center": {
        "orientation": "horizontal",
        "modules": [
            "hyprland/window",
            "mpris"
        ]
    },
    "group/stats": {
        "orientation": "horizontal",
        "modules": [
            "temperature",
            "disk",
            "cpu",
            "memory"
        ]
    },
    "group/connect": {
        "orientation": "horizontal",
        "modules": [
            "network",
            "battery"
        ]
    },
    "group/time": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "tray",
            "clock"
        ]
    },
    "modules-right": [
        "group/connect",
        "group/stats",
        "group/time"
    ]}
