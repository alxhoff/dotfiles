{
    "layer": "top",
    "name": "primary",
    "margin-top": 4,
    "margin-bottom": 0,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 0,

    "include": [
        "~/.config/ml4w/settings/waybar-quicklinks.json",
        "~/.config/waybar/modules.json"
    ],
    "modules-left": [
        "custom/appmenu",
        "hyprland/workspaces",
        "group/quicklinks",
        "custom/exit",
        "idle_inhibitor",
        "custom/passthrough"
    ],
    "group/quicklinks": {
        "orientation": "horizontal",
        "spacing": 0,
        "modules": [
            "custom/quicklink1",
            "custom/quicklink2",
            "custom/quicklink3"
        ]
    },
    "modules-center": [
        "group/center"
    ],
    "group/center": {
        "orientation": "horizontal",
        "modules": [
            "hyprland/window",
            "group/media-row"
        ]
    },
    "group/media-row": {
        "orientation": "horizontal",
        "modules": [
            "custom/media-title",
            "custom/media-prev",
            "custom/media-play",
            "custom/media-next"
        ]
    },
    "group/stats": {
        "orientation": "horizontal",
        "modules": [
            "temperature",
            "disk",
            "cpu",
            "memory"
        ]
    },
    "group/connect": {
        "orientation": "horizontal",
        "modules": [
            "custom/network",
            "battery"
        ]
    },
    "group/time": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "tray",
            "clock"
        ]
    },
    "modules-right": [
        "group/connect",
        "group/time"
    ]}
