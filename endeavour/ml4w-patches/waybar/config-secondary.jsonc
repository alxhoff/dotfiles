{
    "layer": "top",
    "name": "secondary",
    "margin-top": 3,
    "margin-bottom": 0,
    "margin-left": 6,
    "margin-right": 6,
    "spacing": 0,

    "include": [
        "~/.config/waybar/modules.json"
    ],
    "modules-left": [
        "hyprland/workspaces",
        "custom/passthrough"
    ],
    "modules-center": [
        "group/media-row"
    ],
    "group/media-row": {
        "orientation": "horizontal",
        "modules": [
            "custom/media-title",
            "custom/media-prev",
            "custom/media-play",
            "custom/media-next"
        ]
    },
    "custom/media-title": {
        "exec": "MEDIA_BLOCK_WIDTH=16 ~/.config/ml4w/scripts/media-title.sh"
    },
    "modules-right": [
        "group/stats",
        "group/time"
    ],

    "group/stats": {
        "orientation": "horizontal",
        "modules": [
            "temperature",
            "disk",
            "cpu",
            "memory"
        ]
    },

    "group/time": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "clock"
        ]
    }
}