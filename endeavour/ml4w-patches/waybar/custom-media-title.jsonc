    "custom/media-title": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/ml4w/scripts/media-title.sh",
        "interval": 1,
        "escape": false,
        "tooltip-format": "Now playing",
        "on-click": "~/.config/ml4w/scripts/media-playerctl.sh play-pause",
        "on-click-right": "~/.config/ml4w/scripts/media-playerctl.sh next",
        "on-click-middle": "~/.config/ml4w/scripts/media-playerctl.sh previous",
        "on-scroll-up": "~/.config/ml4w/scripts/media-playerctl.sh volume 0.05+",
        "on-scroll-down": "~/.config/ml4w/scripts/media-playerctl.sh volume 0.05-"
    },
